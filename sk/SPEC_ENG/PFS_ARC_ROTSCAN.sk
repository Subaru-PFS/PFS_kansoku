#**********************************************************************
#
# PFS_ARC_ROTSCAN.sk
#   (GETARC version of PFS_TRACE_ROTSCAN)
#
# -- Move Instrument rotator and take one Arc (GETARC) at each position
#      -174, -150, -120, ..., +120, +150, +174
#
# example in OPE file:
# PFS_ARC_ROTSCAN OBE_ID=PFS OBE_MODE=SPEC_ENG CAMERA="all" NE=5.0 SEQ_COMMENT="brn arm"
# PFS_ARC_ROTSCAN OBE_ID=PFS OBE_MODE=SPEC_ENG CAMERA="all" NE=5.0 SEQ_COMMENT="brn arm" SKIPEDGE=YES
#
#**********************************************************************
:Header
    SCRIPT_AUTHOR=Arai
    SCRIPT_UPDATE=2026.11.21
    OBE_ID=PFS
    OBE_MODE=SPEC_ENG
    COMMAND=PFS_ARC_ROTSCAN

:Parameter
# Exposure (passed to GETARC)
    # EXPTIME for each lamp. When > 0, that lamp is on during the exposure.
    HGCD=0.0
    AR=0.0
    XE=0.0
    NE=0.0
    KR=0.0
    NFRAME=1
    CAMERA="all"
    ARM=NOP
    SPECNUM=NOP
    SEQ_NAME=NOP
    SEQ_COMMENT=NOP
# Rotator positions
    ROT_EDGE_NEG=-174
    ROT_EDGE_POS=174
    ROT_START=-150
    DROTA=30
    NMOVE_ROTA=11
# Skip the +/-174 deg (edge) positions (YES) or take them (NO)
    SKIPEDGE=NO
    *SKIPEDGE="YES,NO"
# Confirm cobras are at HOME once at the beginning (YES) or skip it (NO)
    CHECKHOME=YES
    *CHECKHOME="YES,NO"

:Command
:start

    EXEC OBS Set_message obsinfo1=clear obsinfo2="PFS_ARC_ROTSCAN" obsinfo3=clear obsinfo4=clear obsinfo5=clear ;

    # Check cobra is home once (skip with CHECKHOME=NO)
    *IF $CHECKHOME == "YES"
        *SUB CHECKCOBRAISHOME OBE_ID=PFS OBE_MODE=SPEC
    *ENDIF

:main_start

    # ---- -174 deg (skip with SKIPEDGE=YES) ----
    *IF $SKIPEDGE == "NO"
        *SET ROTA = $ROT_EDGE_NEG
        EXEC OBS Set_message obsinfo1=clear obsinfo2=nop obsinfo3="moving rotator..." obsinfo4="ROTSCAN: InR = $ROTA deg" obsinfo5=clear ;
        EXEC TSC InsRot_PF Telescope=free COORD=abs POSITION=$ROTA ;
        Exec OBS SLEEP SLEEP_TIME=2 ;
        Exec OBS Check_Status Mode=AND Timeout=0360 N1=[STATS.ROTDIF_PF -0.005 +0.005] ;
        *SUB GETARC OBE_ID=PFS OBE_MODE=SPEC HGCD=$HGCD AR=$AR XE=$XE NE=$NE KR=$KR NFRAME=$NFRAME CAMERA="$CAMERA" ARM="$ARM" SPECNUM="$SPECNUM" SEQ_NAME="$SEQ_NAME" SEQ_COMMENT="$SEQ_COMMENT" CHECKHOME=NO ;
    *ENDIF

    # ---- -150 ... +150 deg (every 30 deg) ----
*FOR $NMOVE_ROTA RSTEP IN

    *SET ROTA = $ROT_START + $DROTA * ($RSTEP - 1)
    EXEC OBS Set_message obsinfo1=clear obsinfo2=nop obsinfo3="moving rotator..." obsinfo4="ROTSCAN: InR = $ROTA deg ($RSTEP / $NMOVE_ROTA)" obsinfo5=clear ;
    EXEC TSC InsRot_PF Telescope=free COORD=abs POSITION=$ROTA ;
    Exec OBS SLEEP SLEEP_TIME=2 ;
    Exec OBS Check_Status Mode=AND Timeout=0360 N1=[STATS.ROTDIF_PF -0.005 +0.005] ;
    *SUB GETARC OBE_ID=PFS OBE_MODE=SPEC HGCD=$HGCD AR=$AR XE=$XE NE=$NE KR=$KR NFRAME=$NFRAME CAMERA="$CAMERA" ARM="$ARM" SPECNUM="$SPECNUM" SEQ_NAME="$SEQ_NAME" SEQ_COMMENT="$SEQ_COMMENT" CHECKHOME=NO ;

*ENDFOR

    # ---- +174 deg (skip with SKIPEDGE=YES) ----
    *IF $SKIPEDGE == "NO"
        *SET ROTA = $ROT_EDGE_POS
        EXEC OBS Set_message obsinfo1=clear obsinfo2=nop obsinfo3="moving rotator..." obsinfo4="ROTSCAN: InR = $ROTA deg" obsinfo5=clear ;
        EXEC TSC InsRot_PF Telescope=free COORD=abs POSITION=$ROTA ;
        Exec OBS SLEEP SLEEP_TIME=2 ;
        Exec OBS Check_Status Mode=AND Timeout=0360 N1=[STATS.ROTDIF_PF -0.005 +0.005] ;
        *SUB GETARC OBE_ID=PFS OBE_MODE=SPEC HGCD=$HGCD AR=$AR XE=$XE NE=$NE KR=$KR NFRAME=$NFRAME CAMERA="$CAMERA" ARM="$ARM" SPECNUM="$SPECNUM" SEQ_NAME="$SEQ_NAME" SEQ_COMMENT="$SEQ_COMMENT" CHECKHOME=NO ;
    *ENDIF

:main_end

    EXEC OBS SOUND SELECT=SOUND_LADY_EI Volume=32 ,
    EXEC OBS Set_message obsinfo1=clear obsinfo2="PFS_ARC_ROTSCAN" obsinfo3="done" obsinfo4=clear obsinfo5=clear ;

:end
