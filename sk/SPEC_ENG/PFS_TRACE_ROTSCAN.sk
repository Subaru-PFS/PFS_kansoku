#**********************************************************************
#
# PFS_TRACE_ROTSCAN
#
# -- Move Instrument rotator and take one Trace (GETTRACE) at each position
#      -174, -150, -120, ..., +120, +150, +174, then return to 0
#
# example in OPE file:
# PFS_TRACE_ROTSCAN OBE_ID=PFS OBE_MODE=SPEC_ENG CAMERA="all" EXPTIME=30 SEQ_NAME="Trace" SEQ_COMMENT="brn arm"
#
#**********************************************************************
:Header
    SCRIPT_AUTHOR=Arai
    SCRIPT_UPDATE=2026.11.10
    OBE_ID=PFS
    OBE_MODE=SPEC_ENG
    COMMAND=PFS_TRACE_ROTSCAN

:Parameter
# Exposure (passed to GETTRACE)
    EXPTIME=30
    NFRAME=1
    CAMERA="all"
    ARM=NOP
    SPECNUM=NOP
    SEQ_NAME="Trace"
    SEQ_COMMENT=NOP
# Rotator positions
    ROT_EDGE_NEG=-174
    ROT_EDGE_POS=174
    ROT_START=-150
    DROTA=30
    NMOVE_ROTA=11
    ROT_END=0
# Confirm cobras are at HOME once at the beginning (YES) or skip it (NO)
    CHECKHOME=YES
    *CHECKHOME="YES,NO"

:Command
:start

    EXEC OBS Set_message obsinfo1=clear obsinfo2="PFS_TRACE_ROTSCAN" obsinfo3=clear obsinfo4=clear obsinfo5=clear ;

    # Check cobra is home once (skip with CHECKHOME=NO)
    *IF $CHECKHOME == "YES"
        *SUB CHECKCOBRAISHOME OBE_ID=PFS OBE_MODE=SPEC
    *ENDIF

:main_start

    # ---- -174 deg ----
    *SET ROTA = $ROT_EDGE_NEG
    EXEC OBS Set_message obsinfo1=clear obsinfo2=nop obsinfo3="moving rotator..." obsinfo4="ROTSCAN: InR = $ROTA deg" obsinfo5=clear ;
    EXEC TSC InsRot_PF Telescope=free COORD=abs POSITION=$ROTA ;
    *SUB GETTRACE OBE_ID=PFS OBE_MODE=SPEC EXPTIME=$EXPTIME NFRAME=$NFRAME CAMERA="$CAMERA" ARM="$ARM" SPECNUM="$SPECNUM" SEQ_NAME="$SEQ_NAME" SEQ_COMMENT="$SEQ_COMMENT" CHECKHOME=NO KEEPINFO=YES ;

    # ---- -150 ... +150 deg (every 30 deg) ----
*FOR $NMOVE_ROTA RSTEP IN

    *SET ROTA = $ROT_START + $DROTA * ($RSTEP - 1)
    EXEC OBS Set_message obsinfo1=clear obsinfo2=nop obsinfo3="moving rotator..." obsinfo4="ROTSCAN: InR = $ROTA deg ($RSTEP / $NMOVE_ROTA)" obsinfo5=clear ;
    EXEC TSC InsRot_PF Telescope=free COORD=abs POSITION=$ROTA ;
    *SUB GETTRACE OBE_ID=PFS OBE_MODE=SPEC EXPTIME=$EXPTIME NFRAME=$NFRAME CAMERA="$CAMERA" ARM="$ARM" SPECNUM="$SPECNUM" SEQ_NAME="$SEQ_NAME" SEQ_COMMENT="$SEQ_COMMENT" CHECKHOME=NO KEEPINFO=YES ;

*ENDFOR

    # ---- +174 deg ----
    *SET ROTA = $ROT_EDGE_POS
    EXEC OBS Set_message obsinfo1=clear obsinfo2=nop obsinfo3="moving rotator..." obsinfo4="ROTSCAN: InR = $ROTA deg" obsinfo5=clear ;
    EXEC TSC InsRot_PF Telescope=free COORD=abs POSITION=$ROTA ;
    *SUB GETTRACE OBE_ID=PFS OBE_MODE=SPEC EXPTIME=$EXPTIME NFRAME=$NFRAME CAMERA="$CAMERA" ARM="$ARM" SPECNUM="$SPECNUM" SEQ_NAME="$SEQ_NAME" SEQ_COMMENT="$SEQ_COMMENT" CHECKHOME=NO KEEPINFO=YES ;

:main_end

    # ---- Return rotator ----
    EXEC OBS Set_message obsinfo1=clear obsinfo2=nop obsinfo3="moving rotator..." obsinfo4="ROTSCAN: InR -> $ROT_END deg (return)" obsinfo5=clear ;
    EXEC TSC InsRot_PF Telescope=free COORD=abs POSITION=$ROT_END ;

    EXEC OBS SOUND SELECT=SOUND_LADY_EI Volume=32 ,
    EXEC OBS Set_message obsinfo1=clear obsinfo2="PFS_TRACE_ROTSCAN" obsinfo3="done" obsinfo4=clear obsinfo5=clear ;

:end